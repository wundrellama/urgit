# systemd unit for the urgit runner daemon (BRIEF-CI-P1 D7).
#
#   install -m 0755 urgit-runner /usr/local/bin/urgit-runner
#   install -d -m 0700 -o urgit-runner -g urgit-runner /etc/urgit-runner
#   install -m 0600 -o urgit-runner -g urgit-runner urgit-runner.toml /etc/urgit-runner/config.toml
#   systemctl enable --now urgit-runner
#
# Runs as an unprivileged user that owns the rootless Docker daemon named
# by docker_host. EnvironmentFile is optional (for example to set
# XDG_RUNTIME_DIR for that user's rootless daemon).
[Unit]
Description=urgit runner daemon (%urgit-ci job executor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=urgit-runner
Group=urgit-runner
EnvironmentFile=-/etc/default/urgit-runner
ExecStart=/usr/local/bin/urgit-runner -config /etc/urgit-runner/config.toml
Restart=on-failure
RestartSec=10
StateDirectory=urgit-runner
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
